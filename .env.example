# B&C Merch Store — environment variables
# Copy to `.env.local` for local development. Never commit secrets.

# -----------------------------------------------------------------------------
# App / GitHub Pages demo
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://astridbonoan.github.io/b-c-merchstore.io-
NEXT_PUBLIC_BASE_PATH=/b-c-merchstore.io-
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# Local development tip:
# Leave NEXT_PUBLIC_BASE_PATH empty (or unset) when using `npm run dev`.
# `npm run build:pages` sets the GitHub Pages base path automatically.

# -----------------------------------------------------------------------------
# Supabase (optional — not required for the static GitHub Pages demo)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Stripe (optional — static Pages demo uses a no-charge checkout path)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
